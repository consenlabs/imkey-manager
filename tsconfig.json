{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "esModuleInterop": true, "skipLibCheck": true,
    "resolveJsonModule": true, "types": ["node", "vitest/globals"], "noEmit": true
  },
  "include": ["src/main/**/*.ts", "src/preload/**/*.ts", "src/service/**/*.ts", "src/shared/**/*.ts", "test/**/*.ts", "electron.vite.config.ts", "vitest.config.ts", "playwright.config.ts"]
}
