+++ b/device/src/upgrade_identity.rs
@@ -0,0 +1,107 @@
+//! Read-only identity lookup for normal firmware and interrupted COS upgrades.
+use crate::device_manager::{get_cert, get_se_id};
+use crate::Result;
+
+pub fn get_upgrade_seid() -> Result<String> {
+    read_upgrade_seid(get_cert, get_se_id)
+}
+
+fn read_upgrade_seid<C, S>(read_cert: C, read_seid: S) -> Result<String>
+where
+    C: FnOnce() -> Result<String>,
+    S: FnOnce() -> Result<String>,
+{
+    let cert = read_cert()?;
+    if cert.len() < 4 || cert.len() % 2 != 0 || !cert.bytes().all(|b| b.is_ascii_hexdigit()) {
+        return Err(format_err!("get_upgrade_seid_invalid_certificate"));
+    }
+    // Match cos_upgrade's certificate branches without starting an upgrade.
+    let seid = if cert[..4].eq_ignore_ascii_case("bf21") {
+        read_seid()?
+    } else if cert[..4].eq_ignore_ascii_case("7f21") && cert.len() >= 44 {
+        cert[12..44].to_owned()
+    } else {
+        return Err(format_err!("get_upgrade_seid_invalid_certificate"));
+    };
+    if seid.len() != 32 || !seid.bytes().all(|b| b.is_ascii_hexdigit()) {
+        return Err(format_err!("get_upgrade_seid_invalid_response"));
+    }
+    Ok(seid.to_ascii_uppercase())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    const SEID: &str = "00112233445566778899aabbccddeeff";
+
+    #[test]
+    fn normal_certificate_reads_seid() {
+        for prefix in &["bf21", "BF21"] {
+            let result = read_upgrade_seid(|| Ok(prefix.to_string()), || Ok(SEID.to_string()));
+            assert_eq!(result.unwrap(), SEID.to_ascii_uppercase());
+        }
+    }
+
+    #[test]
+    fn bootloader_certificate_does_not_read_normal_seid() {
+        for prefix in &["7f21", "7F21"] {
+            let cert = format!("{}00000000{}abcd", prefix, SEID);
+            let result = read_upgrade_seid(|| Ok(cert), || panic!("normal SEID unavailable in BL"));
+            assert_eq!(result.unwrap(), SEID.to_ascii_uppercase());
+        }
+    }
+
+    #[test]
+    fn invalid_certificates_fail_without_normal_seid_read() {
+        for cert in &[
+            "",
+            "7f21",
+            "7f2100000000001122",
+            "7f210000000000112233445566778899aabbccddeef",
+            "7f210000000000112233445566778899aabbccddeeg",
+            "7f210000000000112233445566778899aabbccddeeé",
+            "aa210000000000112233445566778899aabbccddeeff",
+        ] {
+            let result =
+                read_upgrade_seid(|| Ok(cert.to_string()), || panic!("invalid certificate"));
+            assert_eq!(
+                result.unwrap_err().to_string(),
+                "get_upgrade_seid_invalid_certificate"
+            );
+        }
+    }
+
+    #[test]
+    fn invalid_normal_seid_is_rejected() {
+        for seid in &[
+            "",
+            "0011",
+            "00112233445566778899aabbccddeefg",
+            "00112233445566778899aabbccddeeff00",
+        ] {
+            let result = read_upgrade_seid(|| Ok("bf21".to_string()), || Ok(seid.to_string()));
+            assert_eq!(
+                result.unwrap_err().to_string(),
+                "get_upgrade_seid_invalid_response"
+            );
+        }
+    }
+
+    #[test]
+    fn certificate_read_error_is_preserved() {
+        let result = read_upgrade_seid(
+            || Err(format_err!("device_not_connected")),
+            || panic!("certificate failed"),
+        );
+        assert_eq!(result.unwrap_err().to_string(), "device_not_connected");
+    }
+
+    #[test]
+    fn normal_seid_read_error_is_preserved() {
+        let result = read_upgrade_seid(
+            || Ok("bf21".to_string()),
+            || Err(format_err!("get_seid_error")),
+        );
+        assert_eq!(result.unwrap_err().to_string(), "get_seid_error");
+    }
+}
