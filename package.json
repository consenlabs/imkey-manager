{
  "name": "imKeyManager",
  "version": "2.1.7-beta",
  "author": "imkey <weiqiang@imkey.im>",
  "description": "imKey Manager @2020",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "node scripts/verify-connector.mjs --warn && electron-vite build && electron-builder",
    "build:dir": "node scripts/verify-connector.mjs --warn && electron-vite build && electron-builder --dir",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit -p tsconfig.renderer.json",
    "lint": "eslint src/main src/preload src/service src/shared src/renderer src/common test --ext .ts,.js,.vue && prettier --check src test --ignore-unknown",
    "test:security": "vitest run test/security",
    "test:connector": "electron-vite build && electron scripts/connector-smoke.cjs",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "test:e2e": "electron-vite build && playwright test",
    "verify:connector": "node scripts/verify-connector.mjs",
    "gen:proto": "node scripts/gen-proto.mjs",
    "format": "prettier --write src test --ignore-unknown"
  },
  "build": {
    "afterSign": "build/notarize.js",
    "productName": "imKey Manager",
    "appId": "com.imkey.imkey-manager",
    "copyright": "Copyright \u00a9 2020 imkey",
    "directories": {
      "output": "build"
    },
    "publish": {
      "provider": "generic",
      "url": "https://files.imkey.im/downloads/imKeyManager"
    },
    "releaseInfo": {
      "releaseNotes": "[{id:1,info:\"\u65b0\u589e Apple Silicon\uff08ARM64\uff09\u539f\u751f\u8fd0\u884c\u652f\u6301\"},{id:2,info:\"\u79fb\u9664\u672c\u5730 RPC Bridge \u548c DApp \u8c03\u7528\u5165\u53e3\uff0c\u4fee\u590d\u672a\u7ecf\u6388\u6743\u7684\u8bbe\u5907\u8c03\u7528\u98ce\u9669\"},{id:3,info:\"\u4fdd\u7559\u8bbe\u5907\u7ed1\u5b9a\u3001\u5e94\u7528\u7ba1\u7406\u53ca\u56fa\u4ef6\u5347\u7ea7\u529f\u80fd\"}]"
    },
    "files": [
      "out/**/*"
    ],
    "dmg": {
      "sign": false,
      "contents": [
        {
          "x": 410,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 130,
          "y": 150,
          "type": "file"
        }
      ]
    },
    "mac": {
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "icon": "build/icons/Icon.icns",
      "extraResources": [
        {
          "from": "./connector.dylib",
          "to": "./"
        },
        {
          "from": "./key.env",
          "to": "./"
        }
      ],
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "mergeASARs": true,
      "files": [
        "out/**/*",
        "!node_modules/@koromix/**/*"
      ]
    },
    "win": {
      "icon": "build/icons/icon.ico",
      "requestedExecutionLevel": "highestAvailable",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "ia32"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "./connector.dll",
          "to": "../"
        },
        {
          "from": "./key.env",
          "to": "../"
        }
      ],
      "files": [
        "out/**/*",
        "!node_modules/@koromix/**/*"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "createDesktopShortcut": true,
      "runAfterFinish": true
    },
    "linux": {
      "icon": "build/icons/icon.icns"
    },
    "asarUnpack": [
      "node_modules/koffi/**"
    ],
    "afterPack": "scripts/package-native.cjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.2",
    "@fortawesome/fontawesome-free": "^5.15.2",
    "dotenv": "^8.2.0",
    "electron-updater": "6.8.9",
    "element-plus": "2.14.7",
    "google-protobuf": "3.15.5",
    "json5": "2.2.3",
    "koffi": "3.3.2",
    "pinia": "4.0.3",
    "vue": "3.5.43",
    "vue-i18n": "11.4.13",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@electron/notarize": "3.1.2",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "1.64.0",
    "@types/google-protobuf": "^3.15.12",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "6.0.9",
    "electron": "43.7.9",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-vue": "10.11.1",
    "less": "^4.1.1",
    "prettier": "3.9.9",
    "protoc-gen-js": "3.21.4-4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.3.0",
    "vitest": "5.0.3",
    "vue-tsc": "3.3.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/consenlabs/imkey-manager.git"
  },
  "bugs": {
    "url": "https://github.com/consenlabs/imkey-manager/issues"
  },
  "homepage": "https://github.com/consenlabs/imkey-manager#readme",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
